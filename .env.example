# N.E.X.U.S. - template local only; copy to .env and fill on this computer.
# The app loads project .env without overriding process-level variables.
NEXUS_ENVIRONMENT=development
NEXUS_PROVIDER=ollama
NEXUS_ENABLE_REMOTE_PROVIDER=false
# Optional comma-separated allowlist for remote LLM providers, e.g. gemini.
NEXUS_REMOTE_PROVIDERS=
NEXUS_PROVIDER_TIMEOUT=120
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Set this only to a name returned by GET /api/tags; this checkout found qwen2.5:0.5b.
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=384
OLLAMA_TEMPERATURE=0.2

# Manual routing is the safe default. Automatic mode uses only these explicitly
# configured, live-verified candidates and still requires an enabled remote budget.
NEXUS_ROUTING_MODE=manual
NEXUS_ROUTER_CANDIDATES=[]
# Optional bounded Architect -> Analyst -> Reviewer LLM stage for ADVANCED/RESEARCH chats.
# Adds up to three model calls before the final response; remote usage stays behind the budget gate.
NEXUS_MULTIAGENT_ENABLED=false
# Native model tool calls are disabled unless an exact provider:model capability
# has been verified and allowlisted. This enables READ tools only; research remains
# behind explicit owner confirmation. Example: ollama:qwen2.5:0.5b
NEXUS_TOOL_CALLING_MODELS=
# Example local candidate (replace IDs/capabilities with verified model metadata):
# [{"provider":"ollama","model":"qwen2.5:0.5b","context_window":2048,"reasoning_score":0,"capabilities":{"chat":true,"streaming":true,"research":false}}]

OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# External research is off until the general opt-in and topic consent are set.
NEXUS_RESEARCH_ENABLED=false
NEXUS_CROSSREF_ENABLED=true
CROSSREF_MAILTO=
NEXUS_TAVILY_ENABLED=false
TAVILY_API_KEY=
NEXUS_TAVILY_DAILY_CALL_LIMIT=5
# Standing approval for billable background Tavily calls; false by default.
NEXUS_TAVILY_AUTONOMOUS_APPROVED=false

# GitHub public reads need no token; optional token should be read-only.
NEXUS_GITHUB_ENABLED=true
GITHUB_TOKEN=

# Remote Gemini calls additionally require an explicit budget in the authenticated UI.
